{
  "version": "2025-11-09",
  "entities": [
    {
      "name": "students",
      "title": "Students",
      "description": "Core student profile records",
      "primary_key": "_id",
      "fields": [
        { "name": "_id", "type": "objectId" },
        { "name": "school", "type": "objectId", "ref": "school" },
        { "name": "first_name", "type": "string" },
        { "name": "last_name", "type": "string" },
        { "name": "email", "type": "string" },
        { "name": "professional_email", "type": "string" },
        { "name": "tele_phone", "type": "string" },
        { "name": "sex", "type": "string", "enum": ["M", "F"] },
        { "name": "civility", "type": "string", "enum": ["MR", "MRS"] },
        { "name": "status", "type": "string", "enum": ["active", "pending", "deleted"] },
        { "name": "student_title_status", "type": "string", "enum": ["current_active","completed","suspended","deactivated","retaking","admission","admission_need_validation","admission_ask_for_revision"] },
        { "name": "admission_status", "type": "string", "enum": ["not_received","received_inprogress","received_not_completed","received_completed"] },
        { "name": "identity_verification_status", "type": "string", "enum": ["not_sent","sent_to_student","details_confirmed","due_date_passed"] },
        { "name": "place_of_birth", "type": "string" },
        { "name": "nationality", "type": "string" },
        { "name": "current_class", "type": "objectId", "ref": "class" },
        { "name": "rncp_title", "type": "objectId", "ref": "rncp_title" },
        { "name": "user_id", "type": "objectId", "ref": "user" },
        { "name": "createdAt", "type": "date" },
        { "name": "updatedAt", "type": "date" }
      ],
      "safe_preview_fields": ["first_name","last_name","email","status","student_title_status"]
    },
    {
      "name": "rncp_title",
      "title": "RNCP Title",
      "description": "RNCP certification titles",
      "primary_key": "_id",
      "fields": [
        { "name": "short_name", "type": "string" },
        { "name": "long_name", "type": "string" },
        { "name": "rncp_code", "type": "string" },
        { "name": "rncp_level", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "year_of_certification", "type": "number" }
      ],
      "safe_preview_fields": ["short_name","rncp_code","rncp_level","status"]
    },
    {
      "name": "school",
      "title": "School",
      "description": "Educational institutions",
      "primary_key": "_id",
      "fields": [
        { "name": "short_name", "type": "string" },
        { "name": "long_name", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "school_siret", "type": "string" },
        { "name": "city", "type": "string", "computed": "from school_address where is_main_address=true" },
        { "name": "country", "type": "string", "computed": "from school_address where is_main_address=true" }
      ],
      "safe_preview_fields": ["short_name","city","country"]
    },
    {
      "name": "class",
      "title": "Class",
      "description": "Student class groups",
      "primary_key": "_id",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "year_of_certification", "type": "number" },
        { "name": "type_evaluation", "type": "string" },
        { "name": "evaluation_step", "type": "string" },
        { "name": "class_active", "type": "boolean" }
      ],
      "safe_preview_fields": ["name","year_of_certification","status"]
    }
  ],
  "relations": [
    { "from": "students.rncp_title", "to": "rncp_title._id", "type": "one_to_one" },
    { "from": "students.school", "to": "school._id", "type": "one_to_one" },
    { "from": "students.current_class", "to": "class._id", "type": "one_to_one" }
  ],
  "constraints": {
    "max_columns_per_table": 30,
    "max_filters_per_request": 10,
    "max_joins_per_request": 3,
    "max_row_cap": 10000
  }
}
